name: 哔哩哔哩
description: 过滤哔哩哔哩广告
compat_arguments:
  displayUpList: auto
  purifyComment: 'true'
  optimizeRequest: 'true'
  sponsorBlock: 'true'
  logLevel: error
  PROXY: PROXY
compat_arguments_schema:
  displayUpList:
    name: '[动态]中[最常访问]的显示方式'
    description: 'auto: 仅当列表中存在直播状态时显示; show: 始终显示; hide: 始终隐藏;'
    default_value: auto
    options:
    - auto
    - show
    - hide
  purifyComment:
    name: '[评论区]过滤置顶评论广告'
    description: 'true: 开启; false: 关闭;'
    default_value: 'true'
    options:
    - 'true'
    - 'false'
  optimizeRequest:
    name: '[评论区]优化加载'
    description: 'true: 开启; false: 关闭;'
    default_value: 'true'
    options:
    - 'true'
    - 'false'
  sponsorBlock:
    name: '[空降助手]跳过视频内插播广告'
    description: 'true: 开启; false: 关闭;'
    default_value: 'true'
    options:
    - 'true'
    - 'false'
  logLevel:
    name: 日志等级
    description: 选择日志输出等级
    default_value: error
    options:
    - error
    - warn
    - info
    - debug
    - off
  PROXY:
    name: PROXY
    description: 代理规则使用的策略
    default_value: PROXY
open_url: https://apps.apple.com/app/id736536022
author: RuCu6[https://github.com/RuCu6], kokoryh[https://github.com/kokoryh], Maasea[https://github.com/Maasea], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
homepage: https://loonlab.103516.xyz/Plugin/
icon: https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/BilibiliPink.png
dns: {}
rules:
- domain:
    match: bsbsb.top
    policy: PROXY
- domain:
    match: api.biliapi.com
    policy: REJECT
- domain:
    match: app.biliapi.com
    policy: REJECT
- domain:
    match: api.biliapi.net
    policy: REJECT
- domain:
    match: app.biliapi.net
    policy: REJECT
- and:
    match:
    - domain_suffix:
        match: chat.bilibili.com
    - or:
        match:
        - domain_keyword:
            match: stun
        - domain_keyword:
            match: tracker
        - domain_keyword:
            match: p2p
    policy: REJECT
- url_regex:
    match: ^http://upos-sz-static\.bilivideo\.com/ssaxcode/\w{2}/\w{2}/\w{32}-1-SPLASH
    policy: REJECT
- url_regex:
    match: ^http://[\d\.]+:8000/v1/resource/\w{32}-1-SPLASH
    policy: REJECT
url_rewrites:
- match: ^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\?
  location: http://reject-dict/
  status_code: 200
- match: ^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material\?
  location: http://reject-dict/
  status_code: 200
- match: ^https:\/\/api\.bilibili\.com\/x\/mengqi\/v1\/resource
  location: http://reject-dict/
  status_code: 200
- match: ^https:\/\/app\.bilibili\.com\/x\/resource\/peak\/download
  location: http://reject-dict/
  status_code: 200
header_rewrites:
- add:
    match: ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(interface\.v1\.(Teenagers\/ModeStatus|Search\/DefaultWords)|view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(PlayPause|ViewEndPage))$
    name: grpc-status
    value: '0'
    type: response
body_rewrites:
- response_jq:
    match: ^https:\/\/api\.live\.bilibili\.com\/xlive\/open-interface\/v2\/tracker\/conf\?
    filter: .data.domains=["wss://tracker.chat.bilibili.com"]
- response_jq:
    match: ^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(show|event\/list2)\?
    filter: .data |= with_entries(if .key | IN("show", "event_list") then .value = [] else . end)
- response_jq:
    match: ^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\?
    filter: del(.data.payment)
- response_jq:
    match: ^https:\/\/api\.bilibili\.com\/pgc\/page\/channel\?
    filter: .data.modules |= map(select(.type != "TIP") | if .type == "BANNER" then .module_data.items |= map(select(.url | startswith("https://www.bilibili.com/blackboard/era/") | not)) else . end)
- response_jq:
    match: ^https:\/\/api\.bilibili\.com\/x\/pd-proxy\/tracker\?
    filter: .data[][]?="stun.chat.bilibili.com:3478"
- response_jq:
    match: ^https:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\?
    filter: delpaths([["data","common_equip"]])
- response_jq:
    match: ^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2\?
    filter: https://raw.githubusercontent.com/shanhaishishan/Loon-Egern/refs/heads/main/bilisx.jq
- response_jq:
    match: ^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\?
    filter: if .data.items then .data.items |= map(select((.banner_item == null) and (.ad_info == null) and (.card_goto == "av") and (.card_type | IN("small_cover_v2", "large_cover_single_v9", "large_cover_v1")))) end
- response_jq:
    match: ^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story\?
    filter: if .data.items then .data.items |= map(select((.ad_info == null) and (.card_goto | IN("vertical_ad_av", "vertical_ad_live", "vertical_ad_picture") | not)) | del(.story_cart_icon, .free_flow_toast, .image_infos, .course_info, .game_info)) end
- response_jq:
    match: ^https:\/\/app\.bilibili\.com\/x\/v2\/account\/mine(\/ipad)?\?
    filter: https://raw.githubusercontent.com/shanhaishishan/Loon-Egern/refs/heads/main/biliwd.jq
- response_jq:
    match: ^https:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo\?
    filter: '.data.vip |= if . != null and .status == 0 then . + { status: 1, type: 2, due_date: 9005270400000, role: 15 } else . end'
map_locals:
- match: ^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list\?
  status_code: 200
  body: '{"code":0,"message":"OK","ttl":1,"data":{"max_time":0,"min_interval":31536000,"pull_interval":31536000,"keep_ids":[],"show":[],"list":[{}],"splash_request_id":""}}'
- match: ^https:\/\/ap[ip]\.bilibili\.com\/x\/(?:resource\/(?:top\/activity|patch\/tab(?:\/v2)?)|v2\/search\/square|vip\/ads\/materials)\?
  status_code: 200
  body: '{"code":-404,"message":"-404","ttl":1,"data":null}'
- match: ^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\?
  status_code: 200
  body: '{"code":0,"data":{"closeType":"close_win","container":[],"showTime":""},"message":"success"}'
- match: ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus$
  body: AAAAABMKEQgCEgl0ZWVuYWdlcnMgAioA
  binary: true
- match: ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$
  body: AAAAACEaHeaQnOe0ouinhumikeOAgeeVquWJp+aIlnVw5Li7KAE=
  binary: true
- match: ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(PlayPause|ViewEndPage))$
  body: AAAAAAA=
  binary: true
scriptings:
- http_request:
    name: '[哔哩哔哩]空降助手'
    match: ^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$
    script_url: https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/bilibili.protobuf.request.js
    env:
      _compat.$argument: '{"logLevel":"error"}'
    timeout: 10
    body_required: true
    binary_body: true
- http_request:
    name: '[哔哩哔哩]ProtoBuf Request'
    match: ^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:app\.viewunite\.v1\.View\/View|main\.community\.reply\.v1\.Reply\/MainList)$
    script_url: https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/bilibili.protobuf.request.js
    env:
      _compat.$argument: '{"purifyComment":true,"logLevel":"error"}'
    timeout: 10
    body_required: true
    binary_body: true
- http_response:
    name: '[哔哩哔哩]ProtoBuf Response'
    match: ^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:app\.(?:show\.v1\.Popular\/Index|dynamic\.v2\.Dynamic\/DynAll|view(?:unite)?\.v1\.View\/(?:View|ViewProgress|RelatesFeed|AIRelateAsync)|playurl\.v1\.PlayURL\/PlayView|playerunite\.v1\.Player\/PlayViewUnite)|polymer\.app\.search\.v1\.Search\/SearchAll|community\.service\.dm\.v1\.DM\/DmView|main\.community\.reply\.v1\.Reply\/MainList|pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$
    script_url: https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/bilibili.protobuf.response.js
    env:
      _compat.$argument: '{"displayUpList":"hide","purifyComment":true,"sponsorBlock":true,"logLevel":"error"}'
    body_required: true
    binary_body: true
- http_response:
    name: '[哔哩哔哩]移除直播间广告'
    match: ^https:\/\/api\.live\.bilibili\.com\/xlive\/(?:app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(?:Room|User))\?
    script_url: https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/bilibili.json.js
    body_required: true
mitm:
  hostnames:
    includes:
    - grpc.biliapi.net
    - app.bilibili.com
    - api.bilibili.com
    - api.live.bilibili.com
    - line3-h5-mobile-api.biligame.com
